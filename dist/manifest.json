{
  "manifest_version": 3,
  "name": "Liquid New Tab",
  "version": "2.0.0",
  "description": "A Liquid Glass new tab with shortcuts, prayer times, Gmail notifications, your calendar and the news.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "128": "favicon.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://news.google.com/*",
    "https://trends.google.com/*",
    "https://calendar.google.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://*.icloud.com/*",
    "https://api.bing.com/*",
    "https://inputtools.google.com/*",
    "https://search-api-r2w3.onrender.com/*"
  ]
}
